  OBJECT_DIR = CMakeFiles\gimbal.dir
  POST_BUILD = C:\Windows\system32\cmd.exe /C "cd /D C:\robomaster\build\gimbal && C:\arm-gnu-toolchain\bin\arm-none-eabi-objcopy.exe -Oihex C:/robomaster/build/gimbal/gimbal.elf C:/robomaster/build/gimbal/gimbal.hex && C:\arm-gnu-toolchain\bin\arm-none-eabi-objcopy.exe -Obinary C:/robomaster/build/gimbal/gimbal.elf C:/robomaster/build/gimbal/gimbal.bin"
  PRE_LINK = cd .
  TARGET_FILE = gimbal.elf
  TARGET_PDB = gimbal.elf.dbg
  TARGET_SUPPORT_DIR = CMakeFiles\gimbal.dir


#############################################
# Utility command for edit_cache

build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\robomaster\build\gimbal && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\robomaster -BC:\robomaster\build\gimbal"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\robomaster\build\gimbal && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\robomaster -BC:\robomaster\build\gimbal"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

# =============================================================================
# Target aliases.

build gimbal: phony gimbal.elf

build gimbal_drivers: phony libgimbal_drivers.a

# =============================================================================
# Folder targets.

# =============================================================================

#############################################
# Folder: C:/robomaster/build/gimbal

build all: phony libgimbal_drivers.a gimbal.elf

