 CMakeFiles/gimbal.dir/gimbal/src/motor_base.cpp.obj CMakeFiles/gimbal.dir/gimbal/src/stm32_hal.cpp.obj CMakeFiles/gimbal.dir/gimbal/src/tick.cpp.obj CMakeFiles/gimbal.dir/gimbal/startup_stm32f407xx.s.obj CMakeFiles/gimbal.dir/gimbal/third_party/SEGGER/RTT/SEGGER_RTT_ASM_ARMv7M.S.obj CMakeFiles/gimbal.dir/gimbal/third_party/SEGGER/RTT/SEGGER_RTT.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/BasicMathFunctions/arm_scale_f32.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/MatrixFunctions/arm_mat_init_f32.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/MatrixFunctions/arm_mat_vec_mult_f32.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/FastMathFunctions/arm_atan2_f32.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/QuaternionMathFunctions/arm_quaternion_product_single_f32.c.obj CMakeFiles/gimbal.dir/Gimbal/third_party/dsp/CMSIS-DSP/Source/BasicMathFunctions/arm_add_f32.c.obj | libgimbal_drivers.a || libgimbal_drivers.a
  FLAGS = -mcpu=cortex-m4 -mthumb -mfpu=fpv4-sp-d16 -mfloat-abi=hard -Wno-unused-parameter -Wno-missing-field-initializers -Wno-pedantic -Wno-unknown-pragmas -Wno-comment -Wno-reorder -g -gdwarf-4
