build CMakeFiles/edit_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\robomaster\build\chassis && "C:\Program Files\CMake\bin\cmake-gui.exe" -SC:\robomaster -BC:\robomaster\build\chassis"
  DESC = Running CMake cache editor...
  pool = console
  restat = 1

build edit_cache: phony CMakeFiles/edit_cache.util


#############################################
# Utility command for rebuild_cache

build CMakeFiles/rebuild_cache.util: CUSTOM_COMMAND
  COMMAND = C:\Windows\system32\cmd.exe /C "cd /D C:\robomaster\build\chassis && "C:\Program Files\CMake\bin\cmake.exe" --regenerate-during-build -SC:\robomaster -BC:\robomaster\build\chassis"
  DESC = Running CMake to regenerate build system...
  pool = console
  restat = 1

build rebuild_cache: phony CMakeFiles/rebuild_cache.util

